rules_version = '2';

// Sinfagram Firestore security rules.
// Baseline: only signed-in users can read or write. Tighten per-collection later
// (e.g. users may only edit their own profile/posts).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
